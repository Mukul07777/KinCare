# web
NEXT_PUBLIC_API_URL=http://localhost:8000

# api (later shifts)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TINYFISH_API_KEY=
LLM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_VOICE_FROM=
SARVAM_API_KEY=

# Real WhatsApp, free to start (Meta Cloud API). Step by step: docs/setup/WHATSAPP_SETUP.md
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_NUMBER=          # business/test number, for the "Say hi" join link
WHATSAPP_VERIFY_TOKEN=    # any string; same one in Meta's webhook settings
WHATSAPP_APP_SECRET=      # verifies webhook signatures
WHATSAPP_TEMPLATE=        # optional approved Utility template "KinCare update: {{1}}", used outside the 24 h window

# Telegram: the FREE chat + caregiver-alert channel (no per-message fee, no 24 h window). Step by step: docs/setup/TELEGRAM_SETUP.md
TELEGRAM_BOT_TOKEN=       # from @BotFather -> /newbot
TELEGRAM_BOT_NAME=        # the bot's username without @, e.g. KinCareDadiBot
TELEGRAM_WEBHOOK_SECRET=  # optional; leave empty to long-poll (works on a laptop, no public URL)

# Optional: real web agents and real phone delivery
# TINYFISH_API_KEY  -> https://agent.tinyfish.ai/api-keys
# TWILIO_WHATSAPP_FROM=+14155238886 (sandbox) / TWILIO_VOICE_FROM=+1xxxxxxxxxx
PUBLIC_WEB_URL=http://localhost:3000   # used in check-in links inside WhatsApp messages

# Payments (Stripe test mode: free sk_test_ key from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=   # optional, from `stripe listen`
# Admin panel: if empty, /admin only opens on this computer
ADMIN_TOKEN=

# Security (docs/SECURITY.md)
KINCARE_DATA_KEY=          # encrypts chats, doctor messages, diagnoses at rest; keep a copy outside the database backups
COOKIE_SECURE=1           # production: session cookie only over HTTPS
KINCARE_ORIGINS=           # other sites allowed to call the API with credentials (the web app itself needs none)
KINCARE_API_URL=http://localhost:8000   # web: where the site forwards /api
# KINCARE_DEMO=1           # laptop demos only: login codes on screen, unsigned webhooks accepted. NEVER on a public server.
