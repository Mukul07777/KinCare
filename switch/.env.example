# Copy to switch/.env (git-ignored) and fill in. Only the Recall Watcher needs these.

# Switch server address: Switch Console -> server -> address, e.g. http://127.0.0.1:59754
SWITCH_URL=

# Registration key: Switch Gateway -> API Keys -> create. Used once by `recall_watcher.py register`.
SWITCH_REGISTRATION_KEY=

# Written by `recall_watcher.py register`. Do not share.
SWITCH_AGENT_ID=
SWITCH_AGENT_KEY=

# Optional: post only in these rooms (comma-separated ids). Default: every room the watcher is in.
SWITCH_ROOM_IDS=

# Optional: KinCare API address and how often the watcher checks (minutes).
KINCARE_API=http://localhost:8000
KINCARE_WATCH_MINUTES=10
